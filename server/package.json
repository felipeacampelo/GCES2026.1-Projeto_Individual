{
    "name": "mk.js-server",
    "version": "0.0.1",
    "author": "Minko Gechev @mgechev",
    "description": "Node.js server for mk.js",
    "scripts": {
        "build": "npm run build:server && npm run build:client",
        "build:client": "node --check ../game/src/mk.js && node --check ../game/src/movement.js && node scripts/check-frontend.js",
        "build:server": "node --check server.js && node --check games.js && node --check db.js",
        "start": "node server.js",
        "dev": "nodemon --legacy-watch server.js",
        "lint": "npm run lint:server && npm run lint:client",
        "lint:client": "cd .. && ./server/node_modules/.bin/eslint game/src/*.js --config server/eslint.config.js",
        "lint:server": "eslint server.js games.js db.js scripts/check-frontend.js eslint.config.js"
    },
    "dependencies": {
        "express": "^4.22.2",
        "pg": "^8.16.0",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "eslint": "^9.29.0",
        "nodemon": "^3.1.10"
    },
    "overrides": {
        "path-to-regexp": "0.1.13"
    },
    "license": "MIT"
}
